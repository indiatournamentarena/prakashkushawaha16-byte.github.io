<style>
/* ====== COLORS: yahan se rang badal sakte ho ====== */
:root{--bg:#0b0b12;--card:#161623;--text:#f4f4f8;--muted:#a3a3b5;--accent:#ff6a00;--accent2:#ffb300;--line:#262638}
/* ================================================= */
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:80px}
html,body{background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.55}
body{background:radial-gradient(900px 500px at 50% -100px,rgba(255,106,0,.18),transparent 70%),var(--bg)}
a{color:inherit}
.wrap{max-width:560px;margin:0 auto;padding:0 16px 40px}

/* Header */
header{position:sticky;top:0;z-index:20;background:rgba(11,11,18,.88);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top,0)}
.hbar{max-width:560px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px}
.brand{display:flex;align-items:center;gap:10px;font-weight:900;font-size:17px;letter-spacing:.5px;text-transform:uppercase;text-decoration:none}
.brand b{color:var(--accent2)}
.logo{width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#e04800);display:grid;place-items:center;box-shadow:0 0 18px rgba(255,106,0,.5)}
.logo svg{width:22px;height:22px}
.hbtn{display:flex;align-items:center;gap:6px;background:linear-gradient(90deg,var(--accent),#ff8a1f);color:#fff;font-weight:800;font-size:14px;padding:10px 14px;border-radius:12px;text-decoration:none;box-shadow:0 4px 16px rgba(255,106,0,.4)}
.hbtn svg{width:16px;height:16px}

/* Hero */
.hero{text-align:center;padding:26px 0 8px}
.pill{display:inline-flex;align-items:center;gap:6px;border:1px solid rgba(255,106,0,.5);background:rgba(255,106,0,.1);color:var(--accent2);font-size:11.5px;font-weight:800;letter-spacing:.8px;padding:7px 14px;border-radius:99px;text-transform:uppercase}
h1{font-size:31px;line-height:1.15;margin:18px 0 12px;font-weight:900;text-transform:uppercase}
h1 .o{color:var(--accent)} h1 .y{color:var(--accent2)}
.lead{color:var(--muted);font-size:15px;max-width:480px;margin:0 auto}

/* Tournament banner */
.banner{position:relative;margin-top:22px;border-radius:20px;overflow:hidden;border:1px solid rgba(255,179,0,.35);min-height:210px;
  background:radial-gradient(circle at 80% 20%,#ff8a1f 0,#a52a00 38%,#14070b 85%);box-shadow:0 12px 40px rgba(255,106,0,.22)}
.banner::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(135deg,rgba(255,255,255,.045) 0 2px,transparent 2px 14px)}
.banner img.bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:2}
.bin{position:relative;padding:22px 18px;text-align:left}
.bin .live{display:inline-block;background:#e11d2e;color:#fff;font-size:11px;font-weight:900;letter-spacing:1.2px;padding:4px 10px;border-radius:6px}
.bin h2{font-size:27px;line-height:1.1;font-weight:900;margin:10px 0 4px;text-shadow:0 3px 0 #7a1800}
.bin p{color:#ffe2b8;font-size:13.5px}
.modes{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.modes span{background:rgba(0,0,0,.4);border:1px solid rgba(255,179,0,.4);color:#ffe2b8;font-size:12px;font-weight:700;padding:4px 10px;border-radius:99px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:16px}
.stats div{background:rgba(0,0,0,.5);border:1px solid rgba(255,179,0,.45);border-radius:12px;padding:10px 4px;text-align:center}
.stats small{display:block;font-size:10.5px;letter-spacing:1px;color:#ffd9a0}
.stats b{display:block;font-size:17px;margin-top:2px}
.stats .pz b{color:#ffd54a;font-size:19px}

/* Download card */
.dlcard{display:flex;align-items:center;gap:16px;margin-top:24px;padding:18px;border-radius:20px;text-decoration:none;
  background:linear-gradient(135deg,rgba(255,106,0,.18),rgba(255,179,0,.06));border:1.5px solid rgba(255,106,0,.7);box-shadow:0 0 30px rgba(255,106,0,.22);transition:transform .15s}
.dlcard:active{transform:scale(.985)}
.dlicon{flex:none;width:58px;height:58px;border-radius:16px;background:linear-gradient(135deg,var(--accent),#e04800);display:grid;place-items:center}
.dlicon svg{width:34px;height:34px}
.dltxt small{display:block;color:var(--accent);font-weight:800;letter-spacing:1px;font-size:12px}
.dltxt strong{display:block;font-size:22px;font-weight:900;margin:1px 0}
.dltxt span{color:var(--muted);font-size:13.5px}
.dlarrow{margin-left:auto;width:26px;height:26px;color:var(--accent2)}

.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
.row2 button,.row2 a{display:flex;align-items:center;justify-content:center;gap:8px;padding:14px 8px;border-radius:14px;border:1px solid var(--line);
  background:var(--card);color:var(--text);font-size:13.5px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;text-decoration:none;cursor:pointer;font-family:inherit}
.row2 a.wa{background:#1f9d55;border-color:#1f9d55;color:#fff}

/* Sections */
section{margin-top:34px}
h2.sec{font-size:21px;font-weight:900;text-transform:uppercase;margin-bottom:14px;text-align:center}
h2.sec span{color:var(--accent)}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px}
.steps{list-style:none;counter-reset:s}
.steps li{counter-increment:s;display:flex;gap:12px;padding:9px 0;font-size:14.5px;border-bottom:1px solid var(--line)}
.steps li:last-child{border:0}
.steps li::before{content:counter(s);flex:none;width:26px;height:26px;border-radius:50%;background:var(--accent);color:#1a0a00;font-weight:800;font-size:13px;display:grid;place-items:center}
.note{font-size:12.5px;color:var(--muted);margin-top:10px}

/* Poster */
.poster{position:relative;border-radius:20px;overflow:hidden;border:1px solid var(--line);box-shadow:0 10px 40px rgba(255,106,0,.18);aspect-ratio:4/5;background:#000}
.poster img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:2}
.pfb{position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:22px;background:radial-gradient(circle at 50% 25%,#ff6a00 0,#8a1c00 40%,#12060a 85%)}
.pfb::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(135deg,rgba(255,255,255,.045) 0 2px,transparent 2px 14px)}
.pfb>*{position:relative}
.pfb .fire{font-size:64px;filter:drop-shadow(0 0 18px #ffb300)}
.pfb .t1{font-size:14px;letter-spacing:6px;color:#ffd9a0;font-weight:700;margin-top:4px}
.pfb .t2{font-size:42px;font-weight:900;line-height:1.05;margin:6px 0 14px;text-shadow:0 4px 0 #7a1800,0 0 30px rgba(255,179,0,.6)}
.pfb .stats{width:100%;max-width:420px}
.pfb .t3{display:inline-block;margin-top:16px;background:#fff;color:#c43e00;font-weight:800;padding:9px 20px;border-radius:10px;font-size:15px}

.feat{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.feat div{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;font-size:14px;font-weight:600}
details{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 16px;margin-bottom:10px}
summary{cursor:pointer;font-weight:700;font-size:14.5px}
details p{color:var(--muted);font-size:14px;margin-top:8px}
footer{text-align:center;color:var(--muted);font-size:12px;margin-top:34px;padding-bottom:20px}
footer p+p{margin-top:6px}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%) translateY(20px);background:#fff;color:#111;padding:10px 18px;border-radius:99px;font-weight:700;font-size:14px;opacity:0;transition:.25s;pointer-events:none;z-index:50}
.toast.on{opacity:1;transform:translateX(-50%)}
</style>
</head>
