<div class="toast" id="toast">Link copy ho gaya ✅</div>

<script>
var pageUrl = location.href.split('#')[0];
var msg = '🔥 Free Fire Tournament App 🔥\nAndroid APK yahan se download karo:\n' + pageUrl;
document.getElementById('waBtn').href = 'https://wa.me/?text=' + encodeURIComponent(msg);
function toast(t){var el=document.getElementById('toast');el.textContent=t;el.classList.add('on');setTimeout(function(){el.classList.remove('on')},2000)}
document.getElementById('copyBtn').addEventListener('click', function(){
  function fb(){var i=document.createElement('input');i.value=pageUrl;document.body.appendChild(i);i.select();
    try{document.execCommand('copy');toast('Link copy ho gaya ✅')}catch(e){toast('Link manually copy karo')}i.remove()}
  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(pageUrl).then(function(){toast('Link copy ho gaya ✅')},fb)}else fb();
});
</script>
